# Referencia de los secrets que hay que cargar en Dashboard > Edge Functions >
# DW_FINNEGANS > Manage secrets — uno por uno (Name/Value), NO como un solo
# JSON. Completar y pegar ahí; no guardar los valores reales en este archivo.
DW_HOST=ribeiro.dw.finneg.com
DW_PORT=5432
DW_DATABASE=
DW_SCHEMA=public
DW_USER=
DW_PASSWORD=
SYNC_SECRET=
# TLS: el DW es un Amazon Aurora (RDS) y su certificado lo firma la CA de RDS,
# que Deno no trae. Sin estos dos, falla con "invalid peer certificate: UnknownIssuer".
# DW_CA_CERT = bundle PEM oficial de RDS us-east-1
#   (https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem)
# DW_TLS_SERVERNAME = host de RDS para el que está emitido el certificado
#   (ribeiro.dw.finneg.com es un alias, el cert no coincide con ese nombre)
# DW_SSL_INSECURE = true  (NO usar: no verifica el certificado y además
#   postgres.js en Deno no respeta rejectUnauthorized:false)
